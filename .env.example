# Copy values into your shell or override Spring/Vite env as needed.
# Do not commit real secrets.

# Postgres (matches docker-compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=oj
POSTGRES_USER=oj
POSTGRES_PASSWORD=oj

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=oj
RABBITMQ_PASSWORD=oj

# API
JWT_SECRET=change-me-before-any-public-deploy-use-long-random-string
SERVER_PORT=8080

# Frontend (Vite)
# Local: leave empty or http://localhost:8080
# Pages build: set base path in vite.config; API URL via VITE_API_URL if hosted
VITE_API_URL=http://localhost:8080

# Judge
JUDGE_WORKDIR=/tmp/oj-judge
# process | docker (docker is experimental)
JUDGE_MODE=process
